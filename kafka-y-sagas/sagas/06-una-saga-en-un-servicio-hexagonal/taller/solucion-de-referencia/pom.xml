<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>
  <groupId>curso.kafkaysagas</groupId>
  <artifactId>sagas-06</artifactId>
  <version>1.0</version>
  <properties>
    <java.version>21</java.version>
    <kafka.version>4.3.1</kafka.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- El servicio de pedidos del módulo hexagonal (solución de referencia del taller 08 de hexagonal). Solo lectura: se copia y se compila la copia. -->
    <hexagonal.src>${project.basedir}/../../../../../hexagonal/08-pruebas-y-limites/taller/solucion-de-referencia/src</hexagonal.src>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
          <useManifestOnlyJar>false</useManifestOnlyJar>
          <trimStackTrace>false</trimStackTrace>
          <!-- un cuelgue es un fallo, no un bloqueo: cada prueba tiene 15 minutos y el módulo 40 -->
          <forkedProcessTimeoutInSeconds>2400</forkedProcessTimeoutInSeconds>
          <systemPropertyVariables>
            <junit.jupiter.execution.timeout.default>15m</junit.jupiter.execution.timeout.default>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copiar-servicio-hexagonal</id>
            <phase>generate-sources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/hexagonal-base</outputDirectory>
              <overwrite>true</overwrite>
              <resources><resource><directory>${hexagonal.src}</directory></resource></resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>anadir-servicio-hexagonal</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration><sources><source>${project.build.directory}/hexagonal-base</source></sources></configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
