<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Solo para heredar las versiones que fija Spring Boot, entre ellas la de Reactor. Este programa no usa Spring. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>curso.webflux</groupId>
    <artifactId>s03-antes</artifactId>
    <version>1.0.0</version>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.projectreactor.tools</groupId>
            <artifactId>blockhound</artifactId>
            <version>1.0.18.RELEASE</version>              <!-- no la fija Spring Boot -->
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Se ejecuta en un JVM aparte (exec:exec): BlockHound necesita opciones de la JVM y no puede
                 instrumentar el propio Maven. "mvn compile exec:exec" o "mvn compile exec:exec@con-blockhound". -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.7.0</version>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <arguments>
                        <argument>-XX:+AllowRedefinitionToAddDeleteMethods</argument>
                        <argument>-XX:+EnableDynamicAgentLoading</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>Main</argument>
                    </arguments>
                </configuration>
                <executions>
                    <execution>
                        <id>con-blockhound</id>
                        <configuration>
                            <arguments>
                                <argument>-XX:+AllowRedefinitionToAddDeleteMethods</argument>
                                <argument>-XX:+EnableDynamicAgentLoading</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>Main</argument>
                                <argument>--blockhound</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
