# Plantilla de nginx. La imagen oficial sustituye ${DESTINO_API} por el valor de la variable
# de entorno al arrancar y deja el resultado en /etc/nginx/conf.d/default.conf.
server {
    listen 8080;

    location / {
        root /usr/share/nginx/html;
        index index.html;
    }

    location /api/ {
        proxy_pass ${DESTINO_API};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
