{
  "title": "Pedidos",
  "uid": "pedidos-obs",
  "schemaVersion": 39,
  "panels": [
    {"id":1,"type":"timeseries","title":"Pedidos confirmados por segundo","gridPos":{"h":8,"w":12,"x":0,"y":0},
     "targets":[{"refId":"A","expr":"sum(rate(pedidos_confirmados_total[1m]))","datasource":{"type":"prometheus","uid":"prom-curso"}}]},
    {"id":2,"type":"timeseries","title":"p95 del cobro (s)","gridPos":{"h":8,"w":12,"x":12,"y":0},
     "targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le) (rate(pagos_cobro_duracion_seconds_bucket[1m])))","datasource":{"type":"prometheus","uid":"prom-curso"}}]},
    {"id":3,"type":"timeseries","title":"p95 HTTP por ruta (s)","gridPos":{"h":8,"w":12,"x":0,"y":8},
     "targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le, application, uri) (rate(http_server_requests_seconds_bucket[1m])))","datasource":{"type":"prometheus","uid":"prom-curso"}}]},
    {"id":4,"type":"timeseries","title":"Pedidos en proceso (saturación)","gridPos":{"h":8,"w":12,"x":12,"y":8},
     "targets":[{"refId":"A","expr":"sum(pedidos_en_proceso)","datasource":{"type":"prometheus","uid":"prom-curso"}}]}
  ]
}
