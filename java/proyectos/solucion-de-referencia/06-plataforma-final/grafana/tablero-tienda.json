{
 "title": "Tienda: operación",
 "uid": "tienda-operacion",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Pedidos por segundo",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_requests_seconds_count{application=\"tienda\",uri=\"/pedidos\"}[1m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "title": "Latencia p95 de POST /pedidos",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"tienda\",uri=\"/pedidos\"}[1m])))",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "title": "Peticiones 5xx / total (lo que mide la alerta TiendaErroresAltos)",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(rate(http_server_requests_seconds_count{application=\"tienda\",status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=\"tienda\"}[1m]))) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "title": "Cortacircuitos de la pasarela abierto (1 = abierto; alerta TiendaPasarelaCortada)",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(resilience4j_circuitbreaker_state{application=\"tienda\",name=\"pasarela\",state=\"open\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 5,
   "title": "Memoria de heap de la JVM",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(jvm_memory_used_bytes{application=\"tienda\",area=\"heap\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "title": "Pods de la tienda que Prometheus ve (up)",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(up{job=\"tienda\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  }
 ]
}